# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Clave de OpenRouter (obligatoria para el chat; demo.ts no la necesita)
OPENROUTER_API_KEY=

# Modelo en OpenRouter
LLM_MODELO=anthropic/claude-sonnet-5.5

# Esfuerzo de razonamiento opcional: low, medium o high (vacío = el del proveedor)
LLM_ESFUERZO=

# Clave para entrar al link público (opcional; vacía = chat abierto)
CLAVE_ACCESO=

# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_MS=90000

PORT=3000
